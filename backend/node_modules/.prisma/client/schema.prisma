generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model RFP {
  id             String     @id 
  originalText   String
  structuredJson String
  createdAt      DateTime   @default(now())

  proposals      Proposal[]
}

model Vendor {
  id        String     @id 
  name      String
  email     String     @unique
  phone     String?

  proposals Proposal[]
}

model Proposal {
  id            String   @id 

  vendorId      String
  rfpId         String

  extractedJson String
  totalCost     Float?
  deliveryTime  String?
  warranty      String?

  vendor         Vendor   @relation(fields: [vendorId], references: [id])
  rfp            RFP      @relation(fields: [rfpId], references: [id])

  createdAt      DateTime @default(now())
}
